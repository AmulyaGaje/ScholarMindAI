# =============================================================================
# ScholarMind AI – Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scholarmind_db
POSTGRES_USER=scholarmind_user
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://scholarmind_user:your_secure_password_here@localhost:5432/scholarmind_db

# --- JWT Authentication ---
SECRET_KEY=your_super_secret_jwt_key_min_32_chars_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- App Configuration ---
APP_NAME=ScholarMind AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- File Upload Configuration ---
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=application/pdf

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=ScholarMind AI
VITE_APP_VERSION=1.0.0

# --- Docker (override defaults) ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
